.env
.env.*
!.env.example

# Local databases and book state
*.db
*.db-journal
*.sqlite
*.sqlite3

# Broker / book imports (raw statements, exports)
imports/*.csv

# Serialized objects and model weight caches
*.pkl
.cache/huggingface/
.cache/

