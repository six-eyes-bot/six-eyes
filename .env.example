# Six Eyes — environment template
#
# Copy to `.env` and fill in the values T0 selects. This file holds
# PLACEHOLDERS ONLY — never commit real secrets. `.env` is gitignored.
# Education-only project; see README.md.
#
# The final provider set is decided by the T0 dependency audit
# (internal-docs/T0_DEPENDENCY_AUDIT_PROMPT.md). Everything below is a
# candidate under consideration there — keep only what the ADR picks.

# ─── LLM (required) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Data providers under consideration in T0 (Phase 3) ─────────
# Keyed providers — supply a key only if T0 selects the provider.
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
TIINGO_API_KEY=
EODHD_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
OPENBB_PAT=

# Keyless providers (listed for completeness — no credential to fill):
#   yfinance      — no API key (unofficial Yahoo access)
#   finvizfinance — no API key on the free tier (scrapes finviz)
# SEC EDGAR needs no key but requires an identifying User-Agent
# (e.g. "six-eyes research contact@example.com") per SEC fair-access policy.
SEC_EDGAR_USER_AGENT=

# ─── Ops candidates under consideration in T0 (Ops) ─────────────
# Not data providers, but they need credentials if selected.
# LiteLLM is the intended gateway for all agent LLM calls; Langfuse is tracing.
LITELLM_MASTER_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
